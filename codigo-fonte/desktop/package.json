{
  "name": "trilha-dev",
  "productName": "Trilha Dev",
  "version": "1.0.0",
  "description": "Trilha Dev: aprenda JavaScript, TypeScript, SQL e HTML/CSS (programa de PC)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node ../build.mjs",
    "start": "electron .",
    "predist:win": "node ../build.mjs",
    "dist:win": "electron-packager . \"Trilha Dev\" --platform=win32 --arch=x64 --out=../../release --overwrite --ignore=\"^/node_modules/\\.cache\"",
    "predist:mac": "node ../build.mjs",
    "dist:mac": "electron-packager . \"Trilha Dev\" --platform=darwin --arch=arm64 --out=../../release --overwrite",
    "predist:linux": "node ../build.mjs",
    "dist:linux": "electron-packager . \"Trilha Dev\" --platform=linux --arch=x64 --out=../../release --overwrite"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "@electron/packager": "^18.3.6"
  }
}
