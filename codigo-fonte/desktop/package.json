{
  "name": "trilha-dev",
  "productName": "Overclock",
  "version": "1.1.0",
  "description": "Overclock: aprenda programação do zero ao avançado",
  "author": "Rick",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node ../build.mjs",
    "start": "electron .",
    "dist:win": "node ../build.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.trilha.app",
    "productName": "Overclock",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "../../release"
    },
    "win": {
      "target": "nsis",
      "icon": "app/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overclock",
      "artifactName": "Overclock-Setup.${ext}"
    }
  }
}
